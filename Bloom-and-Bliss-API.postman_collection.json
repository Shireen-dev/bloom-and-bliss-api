{
  "info": {
    "name": "Bloom & Bliss API",
    "description": "Import into Postman to try every endpoint. Set the {{baseUrl}} and {{token}} variables (the token is returned by Register or Login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Priya Rao\",\n  \"email\": \"priya@example.com\",\n  \"password\": \"flowerpower1\"\n}" }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"priya@example.com\",\n  \"password\": \"flowerpower1\"\n}" }
      }
    },
    {
      "name": "Get Current User (me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    { "name": "Get All Products", "request": { "method": "GET", "url": "{{baseUrl}}/products" } },
    { "name": "Get Products by Category", "request": { "method": "GET", "url": "{{baseUrl}}/products?category=Romantic" } },
    { "name": "Get Single Product", "request": { "method": "GET", "url": "{{baseUrl}}/products/1" } },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/products",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Bouquet\",\n  \"price\": 29.99,\n  \"category\": \"Bright\"\n}" }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/products/21",
        "body": { "mode": "raw", "raw": "{\n  \"price\": 34.99\n}" }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/products/21"
      }
    },
    {
      "name": "Get Cart",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/cart" }
    },
    {
      "name": "Add To Cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/cart",
        "body": { "mode": "raw", "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}" }
      }
    },
    {
      "name": "Update Cart Item Quantity",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/cart/1",
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" }
      }
    },
    {
      "name": "Remove Cart Item",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/cart/1" }
    },
    {
      "name": "Checkout (Create Order)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/orders",
        "body": { "mode": "raw", "raw": "{\n  \"shipping\": {\n    \"name\": \"Priya Rao\",\n    \"address\": \"12 Lotus Lane\",\n    \"city\": \"Hubballi\",\n    \"zip\": \"580001\",\n    \"phone\": \"9876543210\"\n  }\n}" }
      }
    },
    {
      "name": "Get My Orders",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/orders" }
    }
  ]
}
